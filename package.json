{
    "license": "MIT",
    "keywords": [
        "datatable",
        "data-grid",
        "table",
        "grid",
        "typescript",
        "vanilla-js",
        "pagination",
        "sorting",
        "filtering",
        "interactive",
        "accessible",
        "component",
        "library",
        "dynatable",
        "jquery-dynatable"
    ],
    "type": "module",
    "version": "1.20.0",
    "name": "snap-records",
    "dependencies": {
        "dexie": "^4.4.5",
        "immer": "^11.1.17",
        "lru-cache": "^11.5.2"
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/snap-records.umd.cjs",
    "module": "./dist/snap-records.es.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/snap-records.es.js",
            "require": "./dist/snap-records.umd.cjs"
        },
        "./dist/*": "./dist/*",
        "./lang/*": "./dist/lang/*",
        "./package.json": "./package.json",
        "./style.css": "./dist/snap-records.css"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lbassuncao/SnapRecords.git"
    },
    "bugs": {
        "url": "https://github.com/lbassuncao/SnapRecords/issues"
    },
    "homepage": "https://github.com/lbassuncao/SnapRecords#readme",
    "devDependencies": {
        "@microsoft/api-extractor": "^7.58.12",
        "@testing-library/dom": "^10.4.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.2.0",
        "@vue/compiler-sfc": "^3.5.41",
        "@vue/language-core": "^3.3.10",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "fake-indexeddb": "^6.2.5",
        "globals": "^17.11.0",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "prettier": "^3.9.6",
        "sass": "^1.102.0",
        "terser": "^5.50.0",
        "ts-jest": "^29.4.12",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.1",
        "vite-plugin-dts": "^5.0.3",
        "vue": "^3.5.41"
    },
    "scripts": {
        "dev": "vite",
        "test": "jest",
        "build:js": "vite build",
        "lint": "eslint \"src/**/*.{js,ts}\" \"demo/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.{js,ts}\" \"demo/**/*.ts\" \"tests/**/*.ts\" --fix",
        "build": "npm run build:js && npm run build:css && mkdir -p dist/lang && cp src/lang/*.json dist/lang/",
        "demo:dev": "vite demo --config vite.config.demo.ts",
        "demo:build": "vite build demo --config vite.config.demo.ts",
        "demo:preview": "vite preview demo --config vite.config.demo.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "build:css": "sass src/scss/SnapRecords.scss dist/snap-records.css --style=compressed --source-map"
    },
    "description": "A powerful and flexible TypeScript data grid component for modern web applications. Features server-side data handling, multiple rendering modes, extensive customization, and full accessibility support.",
    "engines": {
        "node": ">=26.7.0"
    },
    "allowScripts": {
        "unrs-resolver@1.12.2": true,
        "@parcel/watcher": true
    },
    "overrides": {
        "jsdom": "^30.0.1",
        "test-exclude": "^8.0.0",
        "glob": "^13.0.6"
    }
}
