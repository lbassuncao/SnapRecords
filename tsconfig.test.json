{
    "include": ["tests", "src"],
    "compilerOptions": {
        "strict": true,
        "target": "ES2020",
        "module": "ESNext",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "lib": ["ES2020", "DOM"],
        "types": ["jest", "node"],
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "forceConsistentCasingInFileNames": true
    }
}
